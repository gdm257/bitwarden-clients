{
  "name": "bwadmin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build": "cd ../.. && npx nx build bwadmin",
    "build:watch": "cd ../.. && npx nx build bwadmin --watch",
    "build:oss": "cd ../.. && npx nx build bwadmin --configuration=oss",
    "debug": "node ./scripts/debug-start.js",
    "debug:inspect": "node ./scripts/debug-start.js --inspect",
    "dist:oss:win": "npm run build:oss && npm run clean && npm run package:oss:win",
    "dist:oss:mac": "npm run build:oss && npm run clean && npm run package:oss:mac",
    "dist:oss:mac-arm64": "npm run build:oss && npm run clean && npm run package:oss:mac-arm64",
    "dist:oss:lin": "npm run build:oss && npm run clean && npm run package:oss:lin",
    "dist:oss:lin-arm64": "npm run build:oss && npm run clean && npm run package:oss:lin-arm64",
    "package:oss:win": "pkg . --targets node22-win-x64 --output ./dist/oss/windows/bwadmin.exe",
    "package:oss:mac": "pkg . --targets node22-macos-x64 --output ./dist/oss/macos/bwadmin",
    "package:oss:mac-arm64": "pkg . --targets node22-macos-arm64 --output ./dist/oss/macos-arm64/bwadmin",
    "package:oss:lin": "pkg . --targets node22-linux-x64 --output ./dist/oss/linux/bwadmin",
    "package:oss:lin-arm64": "pkg . --targets node22-linux-arm64 --output ./dist/oss/linux-arm64/bwadmin"
  },
  "bin": {
    "bwadmin": "../../dist/apps/bwadmin/oss/bwadmin.js"
  },
  "pkg": {
    "assets": [
      "../../dist/apps/bwadmin/oss/**/*"
    ]
  }
}
